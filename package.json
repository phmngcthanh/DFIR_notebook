    "react": "^19.2.0",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^14.0.0",
    "vis-data": "^8.0.3",
    "vis-timeline": "^8.5.1",
    "vis-util": "^6.0.0",
