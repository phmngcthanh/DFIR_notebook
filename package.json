    "server-test": "node scripts/server.mjs test",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "tauri-build": "node scripts/tauri-build.mjs",
    "tauri-build:windows": "node scripts/tauri-build.mjs --target x86_64-pc-windows-msvc --bundles nsis",
    "tauri-build:linux": "node scripts/tauri-build.mjs --bundles deb,appimage",
    "tauri-build:mac-intel": "node scripts/tauri-build.mjs --target x86_64-apple-darwin --bundles app,dmg",
    "tauri-build:mac-apple": "node scripts/tauri-build.mjs --target aarch64-apple-darwin --bundles app,dmg",
    "tauri-build:mac-universal": "node scripts/tauri-build.mjs --target universal-apple-darwin --bundles app,dmg"
  },
