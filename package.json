  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "server-dev": "node scripts/server.mjs run -- --cases ./cases --allow-create --insecure",
